<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/clip_widget" android:layout_width="match_parent" android:layout_height="match_parent"
    android:contentDescription="@string/clip_widget_description">
    <FrameLayout android:layout_width="48dp" android:layout_height="48dp" android:layout_gravity="center">
        <ImageView android:layout_width="match_parent" android:layout_height="match_parent"
            android:src="@mipmap/ic_launcher_round" android:importantForAccessibility="no" />
        <ImageView android:layout_width="18dp" android:layout_height="18dp" android:layout_gravity="bottom|end"
            android:src="@drawable/clip_widget_add" android:importantForAccessibility="no" />
    </FrameLayout>
</FrameLayout>
