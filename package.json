{
  "name": "xvi-note",
  "version": "0.4.23",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "dev": "node scripts/dev.mjs",
    "dev:ui": "vite --host 127.0.0.1",
    "dev:worker": "wrangler dev --port 8787",
    "prebuild": "node scripts/assets.mjs",
    "build": "tsc --noEmit && vite build",
    "check": "tsc --noEmit",
    "lint": "oxlint --deny-warnings src worker shared tests e2e scripts",
    "theme:check": "node --experimental-strip-types scripts/sync-theme.mjs",
    "theme:sync": "node --experimental-strip-types scripts/sync-theme.mjs --write",
    "test": "vitest run",
    "test:build": "node --experimental-strip-types --test scripts/offline-shell.test.mjs",
    "test:android-cli": "node --test scripts/android.test.mjs",
    "test:android-startup": "node scripts/android-startup-check.mjs",
    "test:android-layout": "node scripts/android-layout-check.mjs",
    "icons": "node scripts/brand-assets.mjs",
    "test:e2e": "playwright test",
    "db:local": "wrangler d1 migrations apply DB --local",
    "db:remote": "wrangler d1 migrations apply DB --remote --env production",
    "setup:local": "node scripts/setup.mjs",
    "reset-password": "node scripts/reset-password.mjs",
    "deploy": "npm run build && npm run db:remote && wrangler deploy --env production",
    "build:android": "node scripts/assets.mjs && tsc --noEmit && vite build --mode android && cap sync android",
    "build:android:release": "npm run build:android && node scripts/android.mjs assembleRelease",
    "android:apk": "npm run build:android && node scripts/android.mjs assembleDebug",
    "install:android": "node scripts/android.mjs install",
    "install:android:release": "node scripts/android.mjs installRelease",
    "android:open": "cap open android",
    "android:release": "npm run build:android && node scripts/android.mjs assembleRelease",
    "android:publish": "node scripts/android-publish.mjs"
  },
  "dependencies": {
    "@capacitor/android": "8.5.2",
    "@capacitor/app": "8.1.1",
    "@capacitor/core": "8.5.2",
    "@codemirror/lang-markdown": "6.5.2",
    "@codemirror/language": "6.12.4",
    "@codemirror/state": "6.7.6",
    "@codemirror/view": "6.43.13",
    "@fontsource/noto-sans-sc": "5.3.0",
    "@fontsource/noto-serif-sc": "5.3.0",
    "@lezer/highlight": "1.2.5",
    "@uiw/react-codemirror": "4.25.12",
    "@zip.js/zip.js": "2.22.0",
    "css-tree": "3.2.1",
    "dompurify": "3.4.16",
    "html2canvas": "1.4.1",
    "katex": "0.16.47",
    "lucide-react": "1.49.0",
    "parse5": "7.3.0",
    "pdfjs-dist": "6.3.289",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "react-markdown": "10.1.0",
    "rehype-katex": "7.0.1",
    "rehype-sanitize": "6.0.0",
    "remark-gfm": "4.0.1",
    "remark-math": "6.0.0",
    "saxes": "6.0.0"
  },
  "devDependencies": {
    "@capacitor/cli": "8.5.2",
    "@cloudflare/vitest-pool-workers": "0.22.0",
    "@cloudflare/workers-types": "5.20261001.1",
    "@playwright/test": "1.63.0",
    "@testing-library/react": "16.3.3",
    "@types/css-tree": "3.2.0",
    "@types/node": "26.6.3",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.1.1",
    "fake-indexeddb": "6.2.5",
    "happy-dom": "20.14.5",
    "oxlint": "1.86.0",
    "typescript": "7.0.2",
    "vite": "8.3.2",
    "vitest": "4.1.11",
    "wrangler": "4.145.0"
  },
  "overrides": {
    "@cloudflare/vitest-pool-workers": {
      "wrangler": "4.145.0",
      "miniflare": "5.20260930.0-alpha"
    }
  }
}
